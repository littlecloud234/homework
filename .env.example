# ---------------------------------------------------------------------------
# 复制为 .env 后填写。切勿把真实密钥提交到 Git。
# ---------------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（需为 PostgreSQL 16 + pgvector）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/teaching_agent

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 本地不想启动 Worker 时可设为 true，解析任务会同步执行
CELERY_TASK_ALWAYS_EAGER=false

# 对话模型（OpenAI 兼容协议）
# 公有云示例：DeepSeek；私有化时改为 http://gpu-server:8000/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=800

# Embedding 模型（OpenAI 兼容协议）
# 公有云示例：SiliconFlow 的 bge-m3；私有化时指向本地推理服务
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 修改维度后必须重建全部向量，并生成新的数据库迁移
EMBEDDING_DIM=1024

# 检索参数
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.35
MAX_CONTEXT_CHARS=6000
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 生产环境额外配置
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CSRF_TRUSTED_ORIGINS=https://edu.example.com
# SECURE_SSL_REDIRECT=true
